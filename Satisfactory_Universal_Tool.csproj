<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Google.OrTools" Version="9.15.6755" />
    <PackageReference Include="Nodify" Version="7.3.0" />
    <Content Include="CommunityResources\Docs\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Strings\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="logo\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
