<UserControl x:Class="Satisfactory_Universal_Tool.Views.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#1E1E1E">

        <!-- aviso enquanto não tem mapa -->
        <TextBlock Text="{Binding Status}" Foreground="Gray" FontSize="16"
                   TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding HasMap, Converter={StaticResource InverseBoolToVis}}"/>

        <!-- área de mapa: arrasta pra mover, scroll pra zoom -->
        <ScrollViewer x:Name="Scroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasMap, Converter={StaticResource BoolToVis}}"
                      PreviewMouseWheel="Scroll_Zoom">
            <Image Source="{Binding MapImagePath}" Stretch="None"
                   RenderOptions.BitmapScalingMode="HighQuality">
                <Image.LayoutTransform>
                    <ScaleTransform x:Name="MapScale" ScaleX="1" ScaleY="1"/>
                </Image.LayoutTransform>
            </Image>
        </ScrollViewer>
    </Grid>
</UserControl>