<UserControl x:Class="Satisfactory_Universal_Tool.Views.PlannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nodify="https://miroiu.github.io/nodify"
             xmlns:vm="clr-namespace:Satisfactory_Universal_Tool.ViewModels">
    <DockPanel>
        <Button DockPanel.Dock="Top" Content="+ Adicionar nó" Command="{Binding AddNodeCommand}"
                HorizontalAlignment="Left" Padding="8,4" Margin="8"/>

        <nodify:NodifyEditor ItemsSource="{Binding Nodes}"
                             Connections="{Binding Connections}"
                             PendingConnection="{Binding PendingConnection}">

            <!-- posição de cada nó no canvas -->
            <nodify:NodifyEditor.ItemContainerStyle>
                <Style TargetType="{x:Type nodify:ItemContainer}">
                    <Setter Property="Location" Value="{Binding Location, Mode=TwoWay}"/>
                </Style>
            </nodify:NodifyEditor.ItemContainerStyle>

            <!-- como cada nó é desenhado -->
            <nodify:NodifyEditor.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:PlannerNodeViewModel}">
                    <nodify:Node Header="{Binding Title}">
                        <nodify:Node.Input>
                            <nodify:NodeInput Header="{Binding Input.Title}" IsConnected="{Binding Input.IsConnected}"/>
                        </nodify:Node.Input>
                        <nodify:Node.Output>
                            <nodify:NodeOutput Header="{Binding Output.Title}" IsConnected="{Binding Output.IsConnected}"/>
                        </nodify:Node.Output>
                    </nodify:Node>
                </DataTemplate>
            </nodify:NodifyEditor.ItemTemplate>

            <!-- a linha que nasce ao arrastar de um conector -->
            <nodify:NodifyEditor.PendingConnectionTemplate>
                <DataTemplate DataType="{x:Type vm:PendingConnectionViewModel}">
                    <nodify:PendingConnection StartedCommand="{Binding StartCommand}"
                                              CompletedCommand="{Binding FinishCommand}"
                                              AllowOnlyConnectors="True"/>
                </DataTemplate>
            </nodify:NodifyEditor.PendingConnectionTemplate>

            <!-- como cada ligação é desenhada -->
            <nodify:NodifyEditor.ConnectionTemplate>
                <DataTemplate DataType="{x:Type vm:ConnectionViewModel}">
                    <nodify:Connection Source="{Binding Source}" Target="{Binding Target}"/>
                </DataTemplate>
            </nodify:NodifyEditor.ConnectionTemplate>

        </nodify:NodifyEditor>
    </DockPanel>
</UserControl>