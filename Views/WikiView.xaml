<UserControl x:Class="Satisfactory_Universal_Tool.Views.WikiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Satisfactory_Universal_Tool.Localization">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,12,0">
            <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" Foreground="Gray" Margin="0,0,0,4"/>
            <TextBox DockPanel.Dock="Top" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Padding="4" Margin="0,0,0,8"/>
            <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="6,4"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" Cursor="Hand"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <Border Grid.Column="1" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Padding="16">
            <StackPanel DataContext="{Binding SelectedItem}">
                <TextBlock Text="{Binding DisplayName}" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="Pilha: " FontWeight="SemiBold"/><TextBlock Text="{Binding StackSize}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="Estado: " FontWeight="SemiBold"/><TextBlock Text="{Binding Form}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="Pontos no Sink: " FontWeight="SemiBold"/><TextBlock Text="{Binding SinkPoints}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>