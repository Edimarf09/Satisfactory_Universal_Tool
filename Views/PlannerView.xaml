<UserControl x:Class="Satisfactory_Universal_Tool.Views.PlannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nodify="https://miroiu.github.io/nodify"
             xmlns:vm="clr-namespace:Satisfactory_Universal_Tool.ViewModels"
             xmlns:data="clr-namespace:Satisfactory_Universal_Tool.Core.Data">

    <UserControl.Resources>
        <Style x:Key="RoundAddButton" TargetType="Button">
            <Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/>
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#2D6CDF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="20" Background="{TemplateBinding Background}">
                            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.5" Color="Black"/></Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="#3B7BF0"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bg" Property="Background" Value="#255ECB"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundCloseButton" TargetType="Button">
            <Setter Property="Width" Value="22"/><Setter Property="Height" Value="22"/>
            <Setter Property="Foreground" Value="#C7CDD4"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="11" Background="#3A3F45">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="#50565D"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="track" Width="38" Height="20" CornerRadius="10" Background="#3A3F45">
                            <Border x:Name="thumb" Width="16" Height="16" CornerRadius="8" Background="#C7CDD4" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="#2D6CDF"/>
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="thumb" Property="Margin" Value="0,0,2,0"/>
                                <Setter TargetName="thumb" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PickerRowButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E8EAED"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,3"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="row" CornerRadius="8" Background="#2A2E33" BorderBrush="#3A3F45" BorderThickness="1" Padding="8,7">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="Background" Value="#343A41"/>
                                <Setter TargetName="row" Property="BorderBrush" Value="#4C87F0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="row" Property="Background" Value="#3A414A"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ============ EDITOR ============ -->
        <nodify:NodifyEditor x:Name="Editor"
                             ItemsSource="{Binding Nodes}"
                             Connections="{Binding Connections}"
                             ConnectionCompletedCommand="{Binding CreateConnectionCommand}"
                             HasCustomContextMenu="True">

            <nodify:NodifyEditor.InputBindings>
                <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}"/>
            </nodify:NodifyEditor.InputBindings>

            <nodify:NodifyEditor.ItemContainerStyle>
                <Style TargetType="{x:Type nodify:ItemContainer}">
                    <Setter Property="Location" Value="{Binding Location, Mode=TwoWay}"/>
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                </Style>
            </nodify:NodifyEditor.ItemContainerStyle>

            <nodify:NodifyEditor.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:PlannerNodeViewModel}">
                    <nodify:Node Input="{Binding Input}" Output="{Binding Output}">
                        <nodify:Node.Header>
                            <StackPanel Orientation="Horizontal">
                                <!-- SLOT do ícone da máquina (trocar por <Image> depois) -->
                                <Border Width="20" Height="20" CornerRadius="4" Background="#3A414A" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding Glyph}" FontSize="12" Foreground="#E8EAED"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </nodify:Node.Header>

                        <!-- CORPO: usado (topo) / definido (editável, embaixo) conforme o modo -->
                        <StackPanel Margin="0,4" HorizontalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" Foreground="#7CD992" FontWeight="SemiBold"
                                       Text="{Binding MachinesText}"
                                       Visibility="{Binding IsMachinesMode, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock HorizontalAlignment="Center" Foreground="#7CD992" FontWeight="SemiBold"
                                       Text="{Binding UsedRateText}"
                                       Visibility="{Binding IsRateMode, Converter={StaticResource BoolToVis}}"/>

                            <TextBox Width="54" FontSize="11" Margin="0,2,0,0" HorizontalContentAlignment="Center"
                                     Text="{Binding TargetMachines, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding IsMachinesMode, Converter={StaticResource BoolToVis}}"/>
                            <TextBox Width="54" FontSize="11" Margin="0,2,0,0" HorizontalContentAlignment="Center"
                                     Text="{Binding TargetRate, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding IsRateMode, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>

                        <nodify:Node.InputConnectorTemplate>
                            <DataTemplate DataType="{x:Type vm:ConnectorViewModel}">
                                <nodify:NodeInput IsConnected="{Binding IsConnected}" Anchor="{Binding Anchor, Mode=OneWayToSource}">
                                    <nodify:NodeInput.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <!-- SLOT ícone do item -->
                                            <Border Width="16" Height="16" CornerRadius="3" Background="#3A414A" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding Title}"/>
                                            <TextBlock Text="{Binding RateText}" Foreground="#8A9098" Margin="5,0,0,0"/>
                                        </StackPanel>
                                    </nodify:NodeInput.Header>
                                </nodify:NodeInput>
                            </DataTemplate>
                        </nodify:Node.InputConnectorTemplate>

                        <nodify:Node.OutputConnectorTemplate>
                            <DataTemplate DataType="{x:Type vm:ConnectorViewModel}">
                                <nodify:NodeOutput IsConnected="{Binding IsConnected}" Anchor="{Binding Anchor, Mode=OneWayToSource}">
                                    <nodify:NodeOutput.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding RateText}" Foreground="#8A9098" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding Title}"/>
                                            <Border Width="16" Height="16" CornerRadius="3" Background="#3A414A" Margin="5,0,0,0"/>
                                        </StackPanel>
                                    </nodify:NodeOutput.Header>
                                </nodify:NodeOutput>
                            </DataTemplate>
                        </nodify:Node.OutputConnectorTemplate>
                    </nodify:Node>
                </DataTemplate>
            </nodify:NodifyEditor.ItemTemplate>

            <nodify:NodifyEditor.ConnectionTemplate>
                <DataTemplate DataType="{x:Type vm:ConnectionViewModel}">
                    <nodify:Connection Source="{Binding Source.Anchor}" Target="{Binding Target.Anchor}"/>
                </DataTemplate>
            </nodify:NodifyEditor.ConnectionTemplate>
        </nodify:NodifyEditor>

        <!-- ============ BOTÃO "+" (topo-esquerda) ============ -->
        <Button x:Name="AddButton" Style="{StaticResource RoundAddButton}" Click="AddButton_Click"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" ToolTip="Adicionar nó (no centro)">
            <TextBlock Text="+" FontSize="24" FontWeight="Bold" Margin="0,-2,0,0"/>
        </Button>

        <!-- ============ CONFIG (topo-direita) ============ -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                Background="#1B1E22" CornerRadius="10" BorderBrush="#3A3F45" BorderThickness="1" Padding="10">
            <StackPanel Width="180">
                <TextBlock Text="Configurações" Foreground="#8A9098" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="Método de cálculo" Foreground="#C7CDD4" FontSize="11"/>
                <ComboBox ItemsSource="{Binding CalculationMethods}" SelectedItem="{Binding SelectedMethod}"
                          DisplayMemberPath="DisplayName" Margin="0,2,0,8"/>
                <TextBlock Text="Exibir" Foreground="#C7CDD4" FontSize="11"/>
                <ComboBox SelectedIndex="{Binding DisplayModeIndex}" Margin="0,2,0,8">
                    <ComboBoxItem Content="Máquinas"/>
                    <ComboBoxItem Content="Itens / min"/>
                </ComboBox>
                <TextBlock Text="{Binding SolveStatus}" Foreground="#8A9098" FontSize="10" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- ============ JANELA DE SELEÇÃO (2 painéis) ============ -->
        <Popup x:Name="PickerPopup" IsOpen="{Binding IsPickerOpen, Mode=TwoWay}"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
               Focusable="False" Opened="PickerPopup_Opened">
            <Border Width="560" Background="#1B1E22" CornerRadius="12" BorderBrush="#3A3F45" BorderThickness="1" Padding="10">
                <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.55" Color="Black"/></Border.Effect>
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#2A2E33" CornerRadius="9" Padding="10,6" Margin="0,0,0,8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#x1F50D;" Foreground="#9AA0A6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource RoundCloseButton}" Command="{Binding ClosePickerCommand}" Content="&#x2715;"/>
                            <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="White"
                                     CaretBrush="White" VerticalAlignment="Center"
                                     Text="{Binding PickerSearch, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                    </Border>

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,0,8">
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                            <TextBlock Text="Nome" Foreground="#C7CDD4" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding MatchName}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                            <TextBlock Text="Entradas" Foreground="#C7CDD4" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding MatchInputs}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Saídas" Foreground="#C7CDD4" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding MatchOutputs}"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid Height="360">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock DockPanel.Dock="Top" Text="Ferramentas" Foreground="#8A9098" FontWeight="SemiBold" Margin="4,0,0,6"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Tools}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ToolDescriptor}">
                                            <Button Style="{StaticResource PickerRowButton}"
                                                    Command="{Binding DataContext.PickToolCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" ToolTip="{Binding Description}">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="6" Background="#3A414A" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding Glyph}" FontSize="14" Foreground="#E8EAED" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>

                        <DockPanel Grid.Column="1">
                            <TextBlock DockPanel.Dock="Top" Text="Receitas" Foreground="#8A9098" FontWeight="SemiBold" Margin="4,0,0,6"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding RecipeResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type data:GameRecipe}">
                                            <Button Style="{StaticResource PickerRowButton}"
                                                    Command="{Binding DataContext.PickRecipeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="7" Background="#3A414A" Margin="0,0,10,0">
                                                        <TextBlock Text="&#x2699;" FontSize="15" Foreground="#E8EAED" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <Border DockPanel.Dock="Right" Background="#8A5A00" CornerRadius="4" Padding="5,1" VerticalAlignment="Center"
                                                            Visibility="{Binding IsAlternate, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="ALT" Foreground="#FFD8A0" FontSize="10" FontWeight="Bold"/>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Machine}" FontSize="10" Foreground="#8A9098"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>