<Window x:Class="Satisfactory_Universal_Tool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Satisfactory_Universal_Tool.Views"
        xmlns:loc="clr-namespace:Satisfactory_Universal_Tool.Localization"
        Title="Satisfactory Universal Tool" Height="600" Width="720">
    <TabControl Margin="8">

        <TabItem Header="{loc:Tr tab.balancer}">
            <views:BalancerView DataContext="{Binding Balancer}"/>
        </TabItem>

        <TabItem Header="{loc:Tr tab.trains}">
            <views:TrainView DataContext="{Binding Train}"/>
        </TabItem>

        <TabItem Header="{loc:Tr tab.wiki}">
            <views:WikiView DataContext="{Binding Wiki}"/>
        </TabItem>

        <TabItem Header="{loc:Tr tab.planner}">
            <TextBlock Text="🚧 Planejador (nodes) — em construção" FontSize="16" Foreground="Gray"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </TabItem>

        <TabItem Header="{loc:Tr tab.map}">
            <TextBlock Text="🚧 Mapa interativo — em construção" FontSize="16" Foreground="Gray"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </TabItem>

    </TabControl>
</Window>